/-
Why3 1.8.2's real-number theories, audited for the symmetries their models have — in core Lean 4,
no Mathlib.

Why3 (the proof platform under Frama-C/WP and SPARK/GNATprove) ships `real.ExpLog`,
`real.Square` and `real.Trigonometry` as AXIOMATIZED theories: `exp`, `log`, `sqrt`, `cos`, `sin`
and `atan` are uninterpreted symbols constrained by first-order axioms. A theorem proved from
such a theory holds in EVERY model of the axioms. This file asks what those models are, and
proves three answers over an abstract ordered field (of which ℝ is one):

* `real.ExpLog` is NOT categorical: for every β > 0, the pair (x ↦ exp (β x), y ↦ log y / β)
  satisfies all ten axioms (`why3ExpLog_scaled`). β ≤ 0 is excluded (`why3ExpLog_rejects_nonpos`).
  So a Why3 proof that a kernel "computes softmax with respect to exp" is, as a formal statement,
  equally a proof about softmax(βx) for every β > 0 (`softmaxRowWith_scaleExp`,
  `certificate_is_a_family`). Worse, `exp x₀` at any x₀ ≠ 0 can take any value on the right side
  of 1 in some model (`value_freedom_pos/neg`), so NO accuracy bound for an approximation of `exp`
  built without `exp` — polynomial, rational, `pow`/`exp2`, bit trick — follows from the theory
  (`no_approximation_bound_pos/neg`). One value axiom (`value_pins`) or the tangent-line axiom
  (`tangent_rigid`, `tangent_two_sided`) restores categoricity.
* `real.Trigonometry` has a DISCRETE symmetry: (x ↦ cos (5x), x ↦ sin (5x), x ↦ atan x / 5), with
  the same π, satisfies every axiom (`why3Trig_scaled_five`). A rotary-embedding kernel certified
  against this theory could be rotating at five times the frequency.
* `real.Square` IS categorical on the non-negative reals (`why3Square_categorical`): the layernorm
  sign symmetry (−LN) that the test bundle admits is broken by `Sqrt_positive`.

The axioms are transcribed from https://www.why3.org/stdlib/real.html (generated by why3doc 1.8.2),
one structure field per Why3 axiom, in the same order and with the same names. Why3's `inv x` is
`x⁻¹` here; its `0.5 * pi` is `π / 2`. Lemmas and definitions of the Why3 modules (`e`, `log2`,
`log10`, `sqr`, `tan`, `Pow_*`, the hyperbolic functions) are omitted because they add no
constraint. `#print axioms` at the end audits every theorem.
-/
open Std Lean.Grind

namespace Why3RealTheories

variable {F : Type} [Field F] [LE F] [LT F] [LawfulOrderLT F] [IsLinearOrder F] [OrderedRing F]

/-! ## `real.ExpLog` -/

/-- Why3 1.8.2 `module ExpLog`: its ten axioms. `e` is `exp`, `l` is `log`. -/
structure Why3ExpLog (e l : F → F) : Prop where
  exp_zero : e 0 = 1
  exp_sum : ∀ x y, e (x + y) = e x * e y
  exp_increasing : ∀ x y, x ≤ y → e x ≤ e y
  exp_positive : ∀ x, 0 < e x
  exp_inv : ∀ x, e (-x) = (e x)⁻¹
  log_one : l 1 = 0
  log_mul : ∀ x y, 0 < x → 0 < y → l (x * y) = l x + l y
  log_increasing : ∀ x y, 0 < x → x ≤ y → l x ≤ l y
  log_exp : ∀ x, l (e x) = x
  exp_log : ∀ x, 0 < x → e (l x) = x

/-- The exponential with its argument rescaled: the temperature family. -/
def scaleExp (β : F) (e : F → F) : F → F := fun x => e (β * x)

/-- Its inverse, rescaled to match. -/
def scaleLog (β : F) (l : F → F) : F → F := fun y => l y / β

/-- **`real.ExpLog` is not categorical.** Every axiom survives rescaling the argument of `exp`
by any β > 0, with `log` rescaled to match. -/
theorem why3ExpLog_scaled (e l : F → F) (h : Why3ExpLog e l) (β : F) (hβ : 0 < β) :
    Why3ExpLog (scaleExp β e) (scaleLog β l) := by
  have hβ0 : β ≠ 0 := Preorder.ne_of_gt hβ
  have hinv : 0 < β⁻¹ := Field.IsOrdered.inv_pos_iff.mpr hβ
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · show e (β * 0) = 1
    have : β * 0 = 0 := by grind
    rw [this, h.exp_zero]
  · intro x y
    show e (β * (x + y)) = e (β * x) * e (β * y)
    rw [← h.exp_sum]
    congr 1
    grind
  · intro x y hxy
    show e (β * x) ≤ e (β * y)
    exact h.exp_increasing _ _ (OrderedRing.mul_le_mul_of_nonneg_left hxy (Preorder.le_of_lt hβ))
  · intro x
    exact h.exp_positive _
  · intro x
    show e (β * -x) = (e (β * x))⁻¹
    rw [← h.exp_inv]
    congr 1
    grind
  · show l 1 / β = 0
    rw [h.log_one]
    grind
  · intro x y hx hy
    show l (x * y) / β = l x / β + l y / β
    rw [h.log_mul x y hx hy]
    grind
  · intro x y hx hxy
    show l x / β ≤ l y / β
    have := OrderedRing.mul_le_mul_of_nonneg_right (h.log_increasing x y hx hxy)
      (Preorder.le_of_lt hinv)
    grind
  · intro x
    show l (e (β * x)) / β = x
    rw [h.log_exp]
    grind
  · intro x hx
    show e (β * (l x / β)) = x
    have : β * (l x / β) = l x := by grind
    rw [this]
    exact h.exp_log x hx

/-- What the theory does exclude: β ≤ 0. At β = 0, `Log_exp` fails (`log 1 / 0 = 1` is false);
at β < 0, `exp_increasing` fails. So the theory pins the direction of `exp` and nothing about its
rate. -/
theorem why3ExpLog_rejects_nonpos (e l : F → F) (h : Why3ExpLog e l) (β : F) (hβ : β ≤ 0) :
    ¬ Why3ExpLog (scaleExp β e) (scaleLog β l) := by
  intro hs
  rcases LinearOrder.trichotomy β 0 with hlt | heq | hgt
  · -- β < 0: the rescaled `exp` is increasing (0 ≤ 1 ⇒ e 0 ≤ e β) and the original is too
    -- (β ≤ 0 ⇒ e β ≤ e 0), so e β = e 0, and `Log_exp` makes exp injective: β = 0.
    have h1 : e (β * 0) ≤ e (β * 1) :=
      hs.exp_increasing 0 1 (Preorder.le_of_lt OrderedRing.zero_lt_one)
    have e1 : β * 0 = 0 := by grind
    have e2 : β * 1 = β := by grind
    rw [e1, e2] at h1
    have h2 : e β ≤ e 0 := h.exp_increasing β 0 hβ
    have heq : e β = e 0 := by grind
    have hb := h.log_exp β
    have h0 := h.log_exp 0
    rw [heq] at hb
    grind
  · -- β = 0: `Log_exp` for the rescaled pair at x = 1 reads l (e 0) / 0 = 1, and x / 0 = 0.
    subst heq
    have h1 := hs.log_exp 1
    change l (e (0 * 1)) / 0 = 1 at h1
    grind
  · grind

/-- Softmax with respect to an arbitrary exponential, one row at a time. -/
def softmaxRowWith (e : F → F) (xs : List F) : List F := xs.map (fun x => e x / (xs.map e).sum)

omit [LE F] [LT F] [LawfulOrderLT F] [IsLinearOrder F] [OrderedRing F] in
/-- Softmax with respect to the rescaled exponential IS softmax at inverse temperature β:
`softmaxRowWith (scaleExp β e) xs = softmaxRowWith e (β • xs)`. -/
theorem softmaxRowWith_scaleExp (e : F → F) (β : F) (xs : List F) :
    softmaxRowWith (scaleExp β e) xs = softmaxRowWith e (xs.map (fun x => β * x)) := by
  unfold softmaxRowWith scaleExp
  rw [List.map_map, List.map_map]
  rfl

/-- **The consequence for certificates.** Anything provable about `exp` and `log` from Why3's
axioms alone is provable about their rescaling. In particular a theorem of the form "the kernel
model computes `softmaxRowWith exp`" is equally a theorem about `softmaxRowWith (scaleExp β exp)`,
which by `softmaxRowWith_scaleExp` is softmax(βx). The temperature is not in the theory; it is in
whatever the symbol `exp` is later bound to. -/
theorem certificate_is_a_family (Thm : (F → F) → (F → F) → Prop)
    (proof : ∀ e l, Why3ExpLog e l → Thm e l) (e l : F → F) (h : Why3ExpLog e l) (β : F)
    (hβ : 0 < β) : Thm (scaleExp β e) (scaleLog β l) :=
  proof _ _ (why3ExpLog_scaled e l h β hβ)

/-- **One value axiom restores categoricity.** If the theory also fixed `exp` at any one non-zero
point — as Why3's `Trigonometry` fixes `cos pi = -1` — then β = 1, because `Log_exp` makes `exp`
injective. Over ℝ no exact value of `exp 1` is a literal, which is why Why3 states π with
double-precision *bounds*; `tangent_rigid` below is the exact first-order alternative. -/
theorem value_pins (e l : F → F) (h : Why3ExpLog e l) (β : F) (a c : F) (ha : a ≠ 0)
    (hval : e a = c) (hval' : scaleExp β e a = c) : β = 1 := by
  have : e (β * a) = e a := by
    show scaleExp β e a = e a
    rw [hval', hval]
  have h1 := h.log_exp (β * a)
  have h2 := h.log_exp a
  rw [this] at h1
  grind

/-- The tangent-line axiom: `e` lies above its tangent at 0. First-order, about `e` alone. -/
def Tangent (e : F → F) : Prop := ∀ x, 1 + x ≤ e x

theorem mul_one_sub_le_one (e : F → F) (hpos : ∀ x, 0 < e x)
    (hadd : ∀ x y, e (x + y) = e x * e y) (ht : Tangent e) (x : F) : e x * (1 - x) ≤ 1 := by
  have h1 := ht (-x)
  have h0 : e 0 = 1 := by
    have h := hadd 0 0
    have := Preorder.ne_of_gt (hpos 0)
    grind
  have h2 : e x * e (-x) = 1 := by
    rw [← hadd]
    have : x + -x = 0 := by grind
    rw [this, h0]
  have := OrderedRing.mul_le_mul_of_nonneg_left h1 (Preorder.le_of_lt (hpos x))
  grind

/-- **The tangent-line axiom restores categoricity exactly.** If `exp` and its rescaling by β
both satisfy `1 + x ≤ exp x`, then β = 1. Only `exp_positive` and `Exp_sum` are used, so this
holds for Why3's theory and for the minimal three-axiom theory alike. (Proof as in
`proofs/softmax-bundle/SoftmaxBundle.lean`, `tangent_rigid`.) -/
theorem tangent_rigid (e : F → F) (hpos : ∀ x, 0 < e x) (hadd : ∀ x y, e (x + y) = e x * e y)
    (β : F) (ht : Tangent e) (hs : Tangent (scaleExp β e)) : β = 1 := by
  have hs' : ∀ x : F, 1 + x ≤ e (β * x) := hs
  have one : (0 : F) < 1 := OrderedRing.zero_lt_one
  have two : (0 : F) < 2 := by grind
  have key : ∀ x : F, 0 ≤ 1 - β * x → (1 + x) * (1 - β * x) ≤ 1 := by
    intro x hx
    have a := OrderedRing.mul_le_mul_of_nonneg_right (hs' x) hx
    have b := mul_one_sub_le_one e hpos hadd ht (β * x)
    grind
  have key' : ∀ x : F, 0 ≤ 1 - x → (1 + β * x) * (1 - x) ≤ 1 := by
    intro x hx
    have a := OrderedRing.mul_le_mul_of_nonneg_right (ht (β * x)) hx
    have b : e (β * x) * (1 - x) ≤ 1 := mul_one_sub_le_one (scaleExp β e) (fun x => hpos _)
      (fun x y => by show e (β * (x + y)) = e (β * x) * e (β * y); rw [← hadd]; congr 1; grind)
      hs x
    grind
  rcases LinearOrder.trichotomy β 1 with hlt | heq | hgt
  · exfalso
    rcases LinearOrder.trichotomy 0 β with hpos' | hzero | hneg
    · have hinv := Field.IsOrdered.inv_pos_iff.mpr two
      have hb : 0 < 1 - β := by grind
      obtain ⟨x, hxdef⟩ : ∃ x : F, x = (1 - β) * 2⁻¹ := ⟨_, rfl⟩
      have hxpos : 0 < x := by rw [hxdef]; exact OrderedRing.mul_pos hb hinv
      have hx2 : x * 2 = 1 - β := by
        rw [hxdef]
        have := Field.inv_mul_cancel (Preorder.ne_of_gt two)
        grind
      have hβx : β * x < 1 - β := by
        have := OrderedRing.mul_lt_mul_of_pos_left (show β < 2 by grind) hxpos
        grind
      have hk := key x (by grind)
      have := OrderedRing.mul_lt_mul_of_pos_left hβx hxpos
      grind
    · have := key 1 (by grind)
      grind
    · have := key 1 (by grind)
      have := OrderedRing.mul_lt_mul_of_pos_left (show (1 : F) < 1 - β by grind) two
      grind
  · exact heq
  · exfalso
    have hpos' : 0 < β := by grind
    have hb : 0 < β - 1 := by grind
    have h2β : 0 < 2 * β := OrderedRing.mul_pos two hpos'
    have hinv := Field.IsOrdered.inv_pos_iff.mpr h2β
    obtain ⟨x, hxdef⟩ : ∃ x : F, x = (β - 1) * (2 * β)⁻¹ := ⟨_, rfl⟩
    have hxpos : 0 < x := by rw [hxdef]; exact OrderedRing.mul_pos hb hinv
    have hx2 : x * (2 * β) = β - 1 := by
      rw [hxdef]
      have := Field.inv_mul_cancel (Preorder.ne_of_gt h2β)
      grind
    have hx1 : x < 1 := by
      rcases LinearOrder.trichotomy x 1 with h | h | h
      · exact h
      · exfalso; grind
      · exfalso
        have := OrderedRing.mul_lt_mul_of_pos_right h h2β
        grind
    have hβx : β * x < β - 1 := by
      have := OrderedRing.mul_lt_mul_of_pos_left hx1 h2β
      grind
    have hk := key' x (by grind)
    have := OrderedRing.mul_lt_mul_of_pos_left hβx hxpos
    grind

/-! ### Value freedom: `exp` at any non-zero point can be anything on the right side of 1

The scaling symmetry is not a curiosity at one β. Combined with `Exp_log`, it lets a model of
`ExpLog` send `exp x₀` to ANY value y > 1 (for x₀ > 0) or any 0 < y < 1 (for x₀ < 0): take
β = log y / x₀. So nothing about the numerical value of `exp` away from 0 follows from the
theory — and in particular no accuracy bound for an approximation of `exp` that is built
without `exp` (a polynomial, a rational function, `exp2` via `pow`, a bit trick) is a
consequence of the axioms. -/

/-- `log` is positive above 1 and `exp` is above 1 on positives — both from the axioms alone. -/
theorem log_pos_of_one_lt (e l : F → F) (h : Why3ExpLog e l) (y : F) (hy : 1 < y) : 0 < l y := by
  have hy0 : 0 < y := by have := OrderedRing.zero_lt_one (R := F); grind
  have hle : l 1 ≤ l y := h.log_increasing 1 y OrderedRing.zero_lt_one (Preorder.le_of_lt hy)
  rw [h.log_one] at hle
  rcases LinearOrder.trichotomy 0 (l y) with hlt | heq | hgt
  · exact hlt
  · exfalso
    have := h.exp_log y hy0
    rw [← heq, h.exp_zero] at this
    grind
  · exfalso; grind

theorem log_neg_of_lt_one (e l : F → F) (h : Why3ExpLog e l) (y : F) (hy0 : 0 < y) (hy : y < 1) :
    l y < 0 := by
  have hle : l y ≤ l 1 := h.log_increasing y 1 hy0 (Preorder.le_of_lt hy)
  rw [h.log_one] at hle
  rcases LinearOrder.trichotomy (l y) 0 with hlt | heq | hgt
  · exact hlt
  · exfalso
    have := h.exp_log y hy0
    rw [heq, h.exp_zero] at this
    grind
  · exfalso; grind

/-- **Value freedom, x₀ > 0.** For every model of `ExpLog`, every x₀ > 0 and every y > 1 there is
a model of `ExpLog` (a rescaling of the given one) in which `exp x₀ = y`. -/
theorem value_freedom_pos (e l : F → F) (h : Why3ExpLog e l) (x₀ y : F) (hx : 0 < x₀)
    (hy : 1 < y) :
    ∃ e' l' : F → F, Why3ExpLog e' l' ∧ e' x₀ = y := by
  have hl := log_pos_of_one_lt e l h y hy
  have hx0 : x₀ ≠ 0 := Preorder.ne_of_gt hx
  have hinv : 0 < x₀⁻¹ := Field.IsOrdered.inv_pos_iff.mpr hx
  have hβ : 0 < l y / x₀ := by
    have := OrderedRing.mul_pos hl hinv
    grind
  refine ⟨scaleExp (l y / x₀) e, scaleLog (l y / x₀) l, why3ExpLog_scaled e l h _ hβ, ?_⟩
  show e (l y / x₀ * x₀) = y
  have : l y / x₀ * x₀ = l y := by grind
  rw [this]
  exact h.exp_log y (by have := OrderedRing.zero_lt_one (R := F); grind)

/-- **Value freedom, x₀ < 0.** Likewise every 0 < y < 1 is `exp x₀` in some model. -/
theorem value_freedom_neg (e l : F → F) (h : Why3ExpLog e l) (x₀ y : F) (hx : x₀ < 0)
    (hy0 : 0 < y) (hy : y < 1) :
    ∃ e' l' : F → F, Why3ExpLog e' l' ∧ e' x₀ = y := by
  have hl := log_neg_of_lt_one e l h y hy0 hy
  have hx0 : x₀ ≠ 0 := by grind
  -- β = l y / x₀ is a quotient of two negatives
  have hβ : 0 < l y / x₀ := by
    have hnx : 0 < -x₀ := by grind
    have hnl : 0 < -l y := by grind
    have := OrderedRing.mul_pos hnl (Field.IsOrdered.inv_pos_iff.mpr hnx)
    have e1 : l y / x₀ = (-l y) * (-x₀)⁻¹ := by grind
    rw [e1]; exact this
  refine ⟨scaleExp (l y / x₀) e, scaleLog (l y / x₀) l, why3ExpLog_scaled e l h _ hβ, ?_⟩
  show e (l y / x₀ * x₀) = y
  have : l y / x₀ * x₀ = l y := by grind
  rw [this]
  exact h.exp_log y hy0

/-- Two models whose values at x₀ are more than 2ε apart cannot both sit in one band of width 2ε. -/
theorem band_misses_one (v ε ya yb : F) (hgap : ya + (ε + ε) < yb) :
    ¬ (v - ε ≤ ya ∧ ya ≤ v + ε) ∨ ¬ (v - ε ≤ yb ∧ yb ≤ v + ε) := by
  by_cases ha : v - ε ≤ ya ∧ ya ≤ v + ε
  · right
    intro hb
    grind
  · left; exact ha

/-- **No accuracy bound for an `exp`-free approximation follows from `ExpLog` (x₀ > 0).** Let `v`
be what an approximation returns at x₀ > 0 — any element of `F`, computed without `exp` or `log`,
so the same in every model. For EVERY ε ≥ 0 some model of `ExpLog` puts `exp x₀` outside
[v − ε, v + ε]. So "|approx x₀ − exp x₀| ≤ ε" is independent of the theory: no prover that sees
only these axioms can establish it, however loose ε is. Stated with the band unfolded, since core
Lean has no `abs` on an abstract field. -/
theorem no_approximation_bound_pos (e l : F → F) (h : Why3ExpLog e l) (x₀ v ε : F)
    (hx : 0 < x₀) (hε : 0 ≤ ε) :
    ∃ e' l' : F → F, Why3ExpLog e' l' ∧ ¬ (v - ε ≤ e' x₀ ∧ e' x₀ ≤ v + ε) := by
  have one := OrderedRing.zero_lt_one (R := F)
  obtain ⟨ea, la, ha, hva⟩ := value_freedom_pos e l h x₀ 2 hx (by grind)
  obtain ⟨eb, lb, hb, hvb⟩ := value_freedom_pos e l h x₀ (2 + (ε + ε) + 1) hx (by grind)
  rcases band_misses_one v ε 2 (2 + (ε + ε) + 1) (by grind) with hna | hnb
  · exact ⟨ea, la, ha, by rw [hva]; exact hna⟩
  · exact ⟨eb, lb, hb, by rw [hvb]; exact hnb⟩

/-- **The same for x₀ < 0**, where `exp x₀` is confined to (0, 1) and so only bands narrower than
1/2 can be refuted: for ε < 1/4 some model puts `exp x₀` outside [v − ε, v + ε]. -/
theorem no_approximation_bound_neg (e l : F → F) (h : Why3ExpLog e l) (x₀ v ε : F)
    (hx : x₀ < 0) (hε : ε + ε + ε + ε < 1) :
    ∃ e' l' : F → F, Why3ExpLog e' l' ∧ ¬ (v - ε ≤ e' x₀ ∧ e' x₀ ≤ v + ε) := by
  have one := OrderedRing.zero_lt_one (R := F)
  have four : (0 : F) < 4 := by grind
  have q := Field.IsOrdered.inv_pos_iff.mpr four
  have q4 : (4 : F)⁻¹ * 4 = 1 := Field.inv_mul_cancel (Preorder.ne_of_gt four)
  -- the two targets 1/4 and 3/4, both in (0, 1), 1/2 apart
  have qa0 : (0 : F) < 4⁻¹ := q
  have qa1 : (4 : F)⁻¹ < 1 := by grind
  have qb0 : (0 : F) < 3 * 4⁻¹ := by grind
  have qb1 : (3 : F) * 4⁻¹ < 1 := by grind
  obtain ⟨ea, la, ha, hva⟩ := value_freedom_neg e l h x₀ 4⁻¹ hx qa0 qa1
  obtain ⟨eb, lb, hb, hvb⟩ := value_freedom_neg e l h x₀ (3 * 4⁻¹) hx qb0 qb1
  have hgap : (4 : F)⁻¹ + (ε + ε) < 3 * 4⁻¹ := by grind
  rcases band_misses_one v ε 4⁻¹ (3 * 4⁻¹) hgap with hna | hnb
  · exact ⟨ea, la, ha, by rw [hva]; exact hna⟩
  · exact ⟨eb, lb, hb, by rw [hvb]; exact hnb⟩

/-! ### `pow` is invariant, so an `exp2` kernel cannot be tied to an `exp` spec

Why3's `real.PowerReal` defines `pow x y = exp (y * log x)` for x > 0 (`Pow_def`). Under the
rescaling `(exp (β·), log / β)` the right-hand side does not move: `pow` is the SAME function in
every model of the family. A kernel that exponentiates with `pow 2.0 t` — `exp2`, as GPU kernels
do — therefore computes the same value in every model, while the spec's `exp` ranges over the
whole family. So no bound relating the two follows from the theory. -/

/-- Why3 `Pow_def`, as a definition from the pair `(exp, log)`. -/
def powW (e l : F → F) (x y : F) : F := e (y * l x)

omit [LE F] [LT F] [LawfulOrderLT F] [IsLinearOrder F] [OrderedRing F] in
/-- **`pow` is invariant under the symmetry.** -/
theorem pow_invariant (e l : F → F) (β : F) (hβ : β ≠ 0) (x y : F) :
    powW (scaleExp β e) (scaleLog β l) x y = powW e l x y := by
  unfold powW scaleExp scaleLog
  congr 1
  grind

/-- Value freedom with the witness exposed: the model is a rescaling, with β > 0. -/
theorem value_freedom_pos' (e l : F → F) (h : Why3ExpLog e l) (x₀ y : F) (hx : 0 < x₀)
    (hy : 1 < y) : ∃ β : F, 0 < β ∧ scaleExp β e x₀ = y := by
  have hl := log_pos_of_one_lt e l h y hy
  have hinv : 0 < x₀⁻¹ := Field.IsOrdered.inv_pos_iff.mpr hx
  have hx0 : x₀ ≠ 0 := Preorder.ne_of_gt hx
  have hβ : 0 < l y / x₀ := by
    have := OrderedRing.mul_pos hl hinv
    grind
  refine ⟨l y / x₀, hβ, ?_⟩
  show e (l y / x₀ * x₀) = y
  have : l y / x₀ * x₀ = l y := by grind
  rw [this]
  exact h.exp_log y (by have := OrderedRing.zero_lt_one (R := F); grind)

/-- **An `exp2`-based kernel cannot be certified against an `exp` spec from `ExpLog` +
`PowerReal`.** For any constant c (the kernel's `log2 e` literal), any x₀ > 0 and every ε ≥ 0,
some model of the theory puts `exp x₀` more than ε away from the kernel's `pow 2 (c · x₀)` —
computed in that same model. Over ℝ the band holds for the intended model when c ≈ log₂ e, so
the statement is independent: a proof of it must use an assumption outside the theory. -/
theorem exp2_kernel_not_certifiable (e l : F → F) (h : Why3ExpLog e l) (c x₀ ε : F)
    (hx : 0 < x₀) (hε : 0 ≤ ε) :
    ∃ β : F, 0 < β ∧ Why3ExpLog (scaleExp β e) (scaleLog β l) ∧
      ¬ (powW (scaleExp β e) (scaleLog β l) 2 (c * x₀) - ε ≤ scaleExp β e x₀ ∧
         scaleExp β e x₀ ≤ powW (scaleExp β e) (scaleLog β l) 2 (c * x₀) + ε) := by
  have one := OrderedRing.zero_lt_one (R := F)
  -- the kernel's value, the same in every rescaled model
  obtain ⟨v, hv⟩ : ∃ v : F, v = powW e l 2 (c * x₀) := ⟨_, rfl⟩
  obtain ⟨βa, hβa, hva⟩ := value_freedom_pos' e l h x₀ 2 hx (by grind)
  obtain ⟨βb, hβb, hvb⟩ := value_freedom_pos' e l h x₀ (2 + (ε + ε) + 1) hx (by grind)
  rcases band_misses_one v ε 2 (2 + (ε + ε) + 1) (by grind) with hna | hnb
  · refine ⟨βa, hβa, why3ExpLog_scaled e l h βa hβa, ?_⟩
    rw [pow_invariant e l βa (Preorder.ne_of_gt hβa), ← hv, hva]
    exact hna
  · refine ⟨βb, hβb, why3ExpLog_scaled e l h βb hβb, ?_⟩
    rw [pow_invariant e l βb (Preorder.ne_of_gt hβb), ← hv, hvb]
    exact hnb

/-- **And `Tangent` closes it.** Add the tangent line to `ExpLog` and the value of `exp` is no
longer free: in every model, `1 + x₀ ≤ exp x₀` and `exp x₀ · (1 − x₀) ≤ 1` (so `exp x₀ ≤ 1/(1 − x₀)`
for x₀ < 1). The band is two-sided and model-independent, and `Exp_sum` tightens it by halving
(`exp x = exp (x/2)²`), which is how an accuracy bound for an approximation becomes provable. -/
theorem tangent_two_sided (e l : F → F) (h : Why3ExpLog e l) (ht : Tangent e) (x₀ : F) :
    1 + x₀ ≤ e x₀ ∧ e x₀ * (1 - x₀) ≤ 1 :=
  ⟨ht x₀, mul_one_sub_le_one e h.exp_positive h.exp_sum ht x₀⟩

/-! ## `real.Square` -/

/-- Why3 1.8.2 `module Square`: its five axioms about `sqrt` (`r` here). `sqr x` is `x * x`. -/
structure Why3Square (r : F → F) : Prop where
  sqrt_positive : ∀ x, 0 ≤ x → 0 ≤ r x
  sqrt_square : ∀ x, 0 ≤ x → r x * r x = x
  square_sqrt : ∀ x, 0 ≤ x → r (x * x) = x
  sqrt_mul : ∀ x y, 0 ≤ x → 0 ≤ y → r (x * y) = r x * r y
  sqrt_le : ∀ x y, 0 ≤ x → x ≤ y → r x ≤ r y

/-- **`real.Square` is categorical on the non-negative reals**: any two models agree wherever
the axioms speak. In particular `−sqrt`, which satisfies `Sqrt_square`, is excluded by
`Sqrt_positive` — so a Why3 certificate for layernorm cannot be read as one for −LN. -/
theorem why3Square_categorical (r t : F → F) (hr : Why3Square r) (ht : Why3Square t) (x : F)
    (hx : 0 ≤ x) : r x = t x := by
  have h1 := hr.sqrt_square x hx
  have h2 := ht.sqrt_square x hx
  have p1 := hr.sqrt_positive x hx
  have p2 := ht.sqrt_positive x hx
  rcases LinearOrder.trichotomy (r x) (t x) with hlt | heq | hgt
  · exfalso
    -- r x < t x with both non-negative: r·r ≤ r·t < t·t, yet both squares equal x.
    have tpos : 0 < t x := by grind
    have a : r x * r x ≤ r x * t x := OrderedRing.mul_le_mul_of_nonneg_left (Preorder.le_of_lt hlt) p1
    have b : r x * t x < t x * t x := OrderedRing.mul_lt_mul_of_pos_right hlt tpos
    grind
  · exact heq
  · exfalso
    have rpos : 0 < r x := by grind
    have a : t x * t x ≤ t x * r x := OrderedRing.mul_le_mul_of_nonneg_left (Preorder.le_of_lt hgt) p2
    have b : t x * r x < r x * r x := OrderedRing.mul_lt_mul_of_pos_right hgt rpos
    grind

/-! ## `real.Trigonometry` -/

/-- Why3 1.8.2 `module Trigonometry`: every axiom about `cos` (`c`), `sin` (`s`) and `atan`
(`atn`), with `tan x = sin x / cos x` unfolded in `tan_atan`. `Pi_double_precision_bounds`
constrains π alone and is unaffected by the transformation below, so it is carried as a separate
hypothesis where a statement needs it (none here does). -/
structure Why3Trig (c s atn : F → F) (π : F) : Prop where
  pythagorean : ∀ x, c x * c x + s x * s x = 1
  cos_0 : c 0 = 1
  sin_0 : s 0 = 0
  cos_pi : c π = -1
  sin_pi : s π = 0
  cos_pi2 : c (π / 2) = 0
  sin_pi2 : s (π / 2) = 1
  cos_plus_pi : ∀ x, c (x + π) = - c x
  sin_plus_pi : ∀ x, s (x + π) = - s x
  cos_plus_pi2 : ∀ x, c (x + π / 2) = - s x
  sin_plus_pi2 : ∀ x, s (x + π / 2) = c x
  cos_neg : ∀ x, c (-x) = c x
  sin_neg : ∀ x, s (-x) = - s x
  cos_sum : ∀ x y, c (x + y) = c x * c y - s x * s y
  sin_sum : ∀ x y, s (x + y) = s x * c y + c x * s y
  tan_atan : ∀ x, s (atn x) / c (atn x) = x

/-- Rescaling the argument of a trigonometric function. -/
def scaleArg (β : F) (f : F → F) : F → F := fun x => f (β * x)

/-- Rescaling the value of `atan` to match. -/
def scaleVal (β : F) (f : F → F) : F → F := fun x => f x / β

section Trig
variable {c s atn : F → F} {π : F} (h : Why3Trig c s atn π)
include h

omit [LE F] [LT F] [LawfulOrderLT F] [IsLinearOrder F] [OrderedRing F] in
theorem cos_period (x : F) : c (x + (π + π)) = c x := by
  have e1 : x + (π + π) = (x + π) + π := by grind
  rw [e1, h.cos_plus_pi, h.cos_plus_pi]
  grind

omit [LE F] [LT F] [LawfulOrderLT F] [IsLinearOrder F] [OrderedRing F] in
theorem sin_period (x : F) : s (x + (π + π)) = s x := by
  have e1 : x + (π + π) = (x + π) + π := by grind
  rw [e1, h.sin_plus_pi, h.sin_plus_pi]
  grind

omit [LE F] [LT F] [LawfulOrderLT F] [IsLinearOrder F] [OrderedRing F] in
theorem cos_two_periods (x : F) : c (x + ((π + π) + (π + π))) = c x := by
  have e1 : x + ((π + π) + (π + π)) = (x + (π + π)) + (π + π) := by grind
  rw [e1, cos_period h, cos_period h]

omit [LE F] [LT F] [LawfulOrderLT F] [IsLinearOrder F] [OrderedRing F] in
theorem sin_two_periods (x : F) : s (x + ((π + π) + (π + π))) = s x := by
  have e1 : x + ((π + π) + (π + π)) = (x + (π + π)) + (π + π) := by grind
  rw [e1, sin_period h, sin_period h]

end Trig

/-- **`real.Trigonometry` has a discrete symmetry.** `(x ↦ cos (5x), x ↦ sin (5x), x ↦ atan x / 5)`
with the same π satisfies every axiom. (The general statement is β ≡ 1 (mod 4); five is the
smallest witness above one.) -/
theorem why3Trig_scaled_five (c s atn : F → F) (π : F) (h : Why3Trig c s atn π) :
    Why3Trig (scaleArg 5 c) (scaleArg 5 s) (scaleVal 5 atn) π := by
  have five : (5 : F) ≠ 0 := by
    have := OrderedRing.zero_lt_one (R := F)
    grind
  -- 5π = π + 4π and 5(π/2) = π/2 + 4(π/2) = π/2 + 2π: the extra turns vanish by periodicity.
  have fivepi : (5 : F) * π = π + ((π + π) + (π + π)) := by grind
  have fivehalf : (5 : F) * (π / 2) = π / 2 + (π + π) := by grind
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro x; exact h.pythagorean _
  · show c (5 * 0) = 1
    have : (5 : F) * 0 = 0 := by grind
    rw [this, h.cos_0]
  · show s (5 * 0) = 0
    have : (5 : F) * 0 = 0 := by grind
    rw [this, h.sin_0]
  · show c (5 * π) = -1
    rw [fivepi, cos_two_periods h, h.cos_pi]
  · show s (5 * π) = 0
    rw [fivepi, sin_two_periods h, h.sin_pi]
  · show c (5 * (π / 2)) = 0
    rw [fivehalf, cos_period h, h.cos_pi2]
  · show s (5 * (π / 2)) = 1
    rw [fivehalf, sin_period h, h.sin_pi2]
  · intro x
    show c (5 * (x + π)) = - c (5 * x)
    have : (5 : F) * (x + π) = (5 * x + π) + ((π + π) + (π + π)) := by grind
    rw [this, cos_two_periods h, h.cos_plus_pi]
  · intro x
    show s (5 * (x + π)) = - s (5 * x)
    have : (5 : F) * (x + π) = (5 * x + π) + ((π + π) + (π + π)) := by grind
    rw [this, sin_two_periods h, h.sin_plus_pi]
  · intro x
    show c (5 * (x + π / 2)) = - s (5 * x)
    have : (5 : F) * (x + π / 2) = (5 * x + π / 2) + (π + π) := by grind
    rw [this, cos_period h, h.cos_plus_pi2]
  · intro x
    show s (5 * (x + π / 2)) = c (5 * x)
    have : (5 : F) * (x + π / 2) = (5 * x + π / 2) + (π + π) := by grind
    rw [this, sin_period h, h.sin_plus_pi2]
  · intro x
    show c (5 * -x) = c (5 * x)
    have : (5 : F) * -x = -(5 * x) := by grind
    rw [this, h.cos_neg]
  · intro x
    show s (5 * -x) = - s (5 * x)
    have : (5 : F) * -x = -(5 * x) := by grind
    rw [this, h.sin_neg]
  · intro x y
    show c (5 * (x + y)) = c (5 * x) * c (5 * y) - s (5 * x) * s (5 * y)
    have : (5 : F) * (x + y) = 5 * x + 5 * y := by grind
    rw [this, h.cos_sum]
  · intro x y
    show s (5 * (x + y)) = s (5 * x) * c (5 * y) + c (5 * x) * s (5 * y)
    have : (5 : F) * (x + y) = 5 * x + 5 * y := by grind
    rw [this, h.sin_sum]
  · intro x
    show s (5 * (atn x / 5)) / c (5 * (atn x / 5)) = x
    have : (5 : F) * (atn x / 5) = atn x := by grind
    rw [this, h.tan_atan]

/-- What the discrete symmetry does NOT include: rescaling by 2 breaks `Cos_pi`
(cos 2π = 1 ≠ −1), so the theory is not blind to *every* frequency — only to β ≡ 1 (mod 4). -/
theorem why3Trig_rejects_two (c s atn : F → F) (π : F) (h : Why3Trig c s atn π) :
    ¬ Why3Trig (scaleArg 2 c) (scaleArg 2 s) (scaleVal 2 atn) π := by
  intro hs
  have h1 := hs.cos_pi
  change c (2 * π) = -1 at h1
  have : (2 : F) * π = π + π := by grind
  rw [this] at h1
  have := h.cos_plus_pi π
  rw [h.cos_pi] at this
  have one := OrderedRing.zero_lt_one (R := F)
  grind

end Why3RealTheories

